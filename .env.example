# Copy to .env and fill in. .env is never committed.

# PostgreSQL + PostGIS (local cluster on this PC)
DATABASE_URL=postgresql://sitesuit_app:CHANGE_ME@127.0.0.1:5433/site_suitability

# local cluster (the app starts it when it is not running)
PG_BIN=D:\Akash\pg17\bin
PG_DATA=D:\Akash\pg17\data_sitesuit

# Source data on this PC
PUVI_ROOT=D:\Data\Puvi_data\vector
REVENUE_VILLAGE_SHP=D:\Data\Puvi_data\village thaluk district BOUNDARIES\TN_Village\revenue_village.shp
SIPCOT_PARKS_DIR=D:\Projects\Sipcot_Projects\SIPCOT_Park_Layers

# Where each site's project folder is created (01_Source ... 10_Excel)
PROJECTS_ROOT=D:\Projects\Sipcot_Projects

# Templates (kept outside the repo)
PPT_TEMPLATE=D:\Data\SiteSuitability_Templates\Preliminary_Site_Analysis_Template.pptx
LANDCOST_TEMPLATE=D:\Data\Tentative_allotment_Template.xlsx

# Tools
QGIS_PYTHON=C:\Program Files\QGIS 3.40.10\bin\python-qgis-ltr.bat
FMB_DOWNLOADER=D:\code\FMB_Downloader\fetch_fmb_gui (1).py
# optional: FMB portal session cookie (JSESSIONID); empty = the downloader's built-in cookie
FMB_COOKIE=

# Overpass server for roads / railway / towns
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
